# Copy this file to `.env` for local development, or set the same variables
# in the Vercel project settings (Settings → Environment Variables).
# Never commit real values — this file contains placeholders only.

# REQUIRED — Postgres connection string for this app's Supabase project
# (ref: veygdvejfgkjvsxeztsz). Replace <your-password> with the database
# password you chose when creating the Supabase project (Supabase →
# Settings → Database → Database password / reset it there if forgotten).
# This direct-connection form works as-is; for heavy serverless traffic
# Supabase recommends the "Transaction pooler" URI from the same settings
# page (host aws-0-<region>.pooler.supabase.com, port 6543) — either works.
DATABASE_URL=postgresql://postgres:<your-password>@db.veygdvejfgkjvsxeztsz.supabase.co:5432/postgres

# OPTIONAL — Supabase project coordinates. The app itself currently talks
# to Postgres only (through DATABASE_URL above); these are documented here
# so they are ready in Vercel if Supabase Auth/Storage is adopted later.
# The project URL is public; the keys are not — copy them from Supabase →
# Settings → API and set them only in Vercel / your local .env.
#
# Planned use: professional identity documents (the NID front and back
# photos) are intended to move to a PRIVATE Supabase Storage
# bucket, with uploads/downloads done server-side using
# SUPABASE_SERVICE_ROLE_KEY (never expose that key to the browser). Until
# that move is verified live, the documents are stored in the
# `identity_documents` Postgres table and served only through the
# access-controlled getIdentityDocument action.
SUPABASE_URL=https://veygdvejfgkjvsxeztsz.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# OPTIONAL — secret token for the read-only data export used by the
# owner's spreadsheet sync: GET /api/export?token=<EXPORT_TOKEN>
# returns bookings, payments, professionals, reviews and the financial
# ledger as JSON (never passwords, session tokens, NID data or identity
# documents). There is no full-database mode by design: restorable
# backups belong in a separate owner-only channel (e.g. a database
# dump), not behind this token.
# Set a long random value here / in Vercel only — never
# commit the real token. While this variable is unset, the endpoint
# answers 404 to every request, as if it did not exist.
EXPORT_TOKEN=

# OPTIONAL — SSLCOMMERZ payment gateway, SANDBOX ONLY (Master Phase 8).
# The gateway option appears at checkout only when ALL THREE variables
# are set. There is no live mode in the code — the integration speaks
# only to sandbox.sslcommerz.com and refuses to run unless
# SSLCOMMERZ_SANDBOX is exactly "true". Get free sandbox credentials
# from SSLCOMMERZ (store id + store password for the sandbox store);
# never commit real values, and never put the store password anywhere
# near the frontend — it is read server-side only.
# Going live is a separate, separately-approved step: SSLCOMMERZ live
# costs a one-time setup fee plus a per-transaction percentage.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true
