# Copy this file to `.env` for local development, or set the same variables
# in the Vercel project settings (Settings → Environment Variables).
# Never commit real values — this file contains placeholders only.

# REQUIRED — Postgres connection string for this app's Supabase project
# (ref: veygdvejfgkjvsxeztsz). Replace <your-password> with the database
# password you chose when creating the Supabase project (Supabase →
# Settings → Database → Database password / reset it there if forgotten).
# This direct-connection form works as-is; for heavy serverless traffic
# Supabase recommends the "Transaction pooler" URI from the same settings
# page (host aws-0-<region>.pooler.supabase.com, port 6543) — either works.
DATABASE_URL=postgresql://postgres:<your-password>@db.veygdvejfgkjvsxeztsz.supabase.co:5432/postgres

# OPTIONAL — Supabase project coordinates. The app itself currently talks
# to Postgres only (through DATABASE_URL above); these are documented here
# so they are ready in Vercel if Supabase Auth/Storage is adopted later.
# The project URL is public; the keys are not — copy them from Supabase →
# Settings → API and set them only in Vercel / your local .env.
SUPABASE_URL=https://veygdvejfgkjvsxeztsz.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
