# Copy this file to `.env` for local development, or set the same variable
# in the Vercel project settings (Settings → Environment Variables).
#
# Any Postgres database works. For Supabase: open your project →
# Settings → Database → Connection string → "Transaction" pooler, and use
# that URI here (it looks like the line below with your own project ref
# and password — never commit the real value).
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
